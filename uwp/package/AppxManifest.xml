<?xml version="1.0" encoding="utf-8"?>
<!--
  Final package manifest for the Xbox Series Dev Mode build.
  scripts/gha/build_uwp.ps1 replaces @VERSION@ before packing.
  Publisher must match the subject of the signing certificate.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap">

  <Identity
    Name="HavocMasterChief.Xash3DXbox"
    Publisher="CN=HavocMasterChief"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />


  <Properties>
    <DisplayName>Xash3D FWGS (Half-Life)</DisplayName>
    <PublisherDisplayName>HavocMasterChief</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.30035.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="xash3d_uwp.exe" EntryPoint="xash3d_uwp.App">
      <uap:VisualElements
        DisplayName="Half-Life (Xash3D)"
        Description="Xash3D FWGS engine running Half-Life on Xbox Series Dev Mode"
        BackgroundColor="#1a1a1a"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1a1a1a" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
