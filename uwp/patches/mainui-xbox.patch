+++ b/menus/XboxSaves.cpp
@@ -0,0 +1,478 @@
+/*
+XboxSaves.cpp - the Xbox build's Load Game and Save / Load Game screen
+Copyright (C) 2026 HavocMasterChief
+
+This program is free software; you can redistribute it and/or
+modify it under the terms of the GNU General Public License
+as published by the Free Software Foundation; either version 2
+of the License, or (at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+See the GNU General Public License for more details.
+
+One list, newest save first: what it is (chapter or map, quick/auto),
+when, and time played, with the save's screenshot beside it.
+
+  Load Game (title screen)     A load, X delete, B back
+  Save / Load Game (in game)   "New save" on top: A saves a new one.
+                               On a save: A load, Y save over it, X delete.
+
+Deleting and saving over ask first.
+*/
+
+#if XASH_UWP
+
+#include "Framework.h"
+#include "YesNoMessageBox.h"
+#include "keydefs.h"
+#include "XboxRows.h"
+
+#include <ctype.h>
+
+#define XB_SAVES_MAX     128
+#define XB_SAVES_VISIBLE 9
+
+struct xbSave_t
+{
+	char name[CS_SIZE];     // file name without extension, "" for New save
+	char title[CS_SIZE];
+	char when[CS_SIZE];
+	char played[CS_TIME];
+};
+
+/*
+=================
+CMenuXbSaveList
+
+The list: up/down move, the window handles the buttons.
+=================
+*/
+class CMenuXbSaveList : public CMenuBaseItem
+{
+public:
+	typedef CMenuBaseItem BaseClass;
+
+	CMenuXbSaveList() : count( 0 ), cur( 0 ), top( 0 )
+	{
+		charSize = UI_MED_CHAR_HEIGHT;
+	}
+
+	bool KeyDown( int key ) override
+	{
+		int dir = 0;
+		if( UI::Key::IsUpArrow( key )) dir = -1;
+		else if( UI::Key::IsDownArrow( key )) dir = 1;
+		else return false;
+
+		if( count > 0 )
+		{
+			int next = cur + dir;
+			if( next >= 0 && next < count )
+			{
+				cur = next;
+				if( cur < top ) top = cur;
+				if( cur >= top + XB_SAVES_VISIBLE ) top = cur - XB_SAVES_VISIBLE + 1;
+				PlayLocalSound( uiStatic.sounds[SND_MOVE] );
+				_Event( QM_CHANGED );
+			}
+		}
+		return true;
+	}
+
+	bool KeyUp( int key ) override
+	{
+		return UI::Key::IsUpArrow( key ) || UI::Key::IsDownArrow( key );
+	}
+
+	void Draw() override
+	{
+		int rowH = m_scSize.h / XB_SAVES_VISIBLE;
+		int pad = 14 * uiStatic.scaleX;
+		unsigned int flags = ETF_SHADOW | ETF_NOSIZELIMIT | ETF_FORCECOL;
+
+		if( !count )
+		{
+			UI_DrawString( font, m_scPos.x + pad, m_scPos.y, m_scSize.w - pad, rowH,
+				L( "No saved games yet" ), PackRGBA( 180, 180, 180, 255 ), m_scChSize, QM_LEFT, flags );
+			return;
+		}
+
+		for( int i = 0; i < XB_SAVES_VISIBLE && top + i < count; i++ )
+		{
+			const xbSave_t &s = saves[top + i];
+			bool sel = ( top + i == cur );
+			int y = m_scPos.y + i * rowH;
+
+			UI_FillRect( m_scPos.x, y + 2, m_scSize.w, rowH - 4, sel ? PackRGBA( 255, 150, 0, 60 ) : PackRGBA( 0, 0, 0, 120 ));
+			if( sel )
+				UI_FillRect( m_scPos.x, y + 2, 6 * uiStatic.scaleX, rowH - 4, PackRGBA( 255, 165, 0, 255 ));
+
+			unsigned int col = sel ? PackRGBA( 255, 200, 90, 255 ) : PackRGBA( 215, 215, 215, 255 );
+			unsigned int dim = sel ? PackRGBA( 240, 200, 140, 255 ) : PackRGBA( 160, 160, 160, 255 );
+			int small = m_scChSize * 0.75f;
+
+			if( !s.name[0] )
+			{
+				UI_DrawString( font, m_scPos.x + pad, y, m_scSize.w - pad * 2, rowH, s.title, col, m_scChSize, QM_LEFT, flags );
+				continue;
+			}
+
+			// title on top, when and time played under it
+			UI_DrawString( font, m_scPos.x + pad, y + 2, m_scSize.w * 0.7f, rowH * 0.58f, s.title, col, m_scChSize * 0.9f, QM_LEFT, flags );
+			UI_DrawString( font, m_scPos.x + pad, y + rowH * 0.5f, m_scSize.w * 0.6f, rowH * 0.45f, s.when, dim, small, QM_LEFT, flags );
+			UI_DrawString( font, m_scPos.x + m_scSize.w * 0.6f, y + rowH * 0.5f, m_scSize.w * 0.4f - pad, rowH * 0.45f, s.played, dim, small, QM_RIGHT, flags );
+		}
+
+		// more above / below
+		if( top > 0 )
+			UI_DrawString( font, m_scPos.x, m_scPos.y - m_scChSize, m_scSize.w, m_scChSize, "^", PackRGBA( 200, 200, 200, 255 ), m_scChSize, QM_CENTER, flags );
+		if( top + XB_SAVES_VISIBLE < count )
+			UI_DrawString( font, m_scPos.x, m_scPos.y + m_scSize.h, m_scSize.w, m_scChSize, "v", PackRGBA( 200, 200, 200, 255 ), m_scChSize, QM_CENTER, flags );
+	}
+
+	xbSave_t saves[XB_SAVES_MAX];
+	int count, cur, top;
+};
+
+/*
+=================
+CMenuXbSaves
+=================
+*/
+class CMenuXbSaves : public CMenuFramework
+{
+public:
+	typedef CMenuFramework BaseClass;
+	CMenuXbSaves() : CMenuFramework( "CMenuXbSaves" ), saveMode( false ) { }
+
+	void Open( bool save )
+	{
+		saveMode = save;
+		Show();
+	}
+
+	bool KeyDown( int key ) override;
+	bool KeyUp( int key ) override;
+
+	void LoadCb();
+	void SaveNewCb();
+	void SaveOverCb();
+	void DeleteCb();
+
+private:
+	void _Init() override;
+	void _VidInit() override;
+	void Reload() override;
+	void Draw() override;
+
+	void Refresh();
+	void Selected();
+	const xbSave_t *Current() const;
+
+	CMenuXbSaveList list;
+	CMenuYesNoMessageBox dialog;
+	CImage shot;
+	char shotName[CS_SIZE];
+	bool saveMode;
+	int pressed;
+};
+
+static int XB_CompareSaves( const void *a, const void *b )
+{
+	const char *file1 = *((const char **)a);
+	const char *file2 = *((const char **)b);
+	int result = 0;
+
+	// newest first
+	EngFuncs::CompareFileTime( file2, file1, &result );
+	return result;
+}
+
+// the engine's save comment: title, then time, date and time played at fixed offsets
+static bool XB_ReadSave( const char *file, xbSave_t *out )
+{
+	char comment[256];
+
+	if( !EngFuncs::GetSaveComment( file, comment ))
+		return false;
+
+	char time[CS_TIME], date[CS_TIME];
+	COM_FileBase( file, out->name, sizeof( out->name ));
+	Q_strncpy( time, comment + CS_SIZE, CS_TIME );
+	Q_strncpy( date, comment + CS_SIZE + CS_TIME, CS_TIME );
+	snprintf( out->when, sizeof( out->when ), "%s  %s", date, time );
+	snprintf( out->played, sizeof( out->played ), "%s", comment + CS_SIZE + CS_TIME * 2 );
+
+	char *title = comment, *type = NULL, *p = NULL;
+	comment[CS_SIZE - 1] = 0;
+
+	if( comment[0] == '[' && ( p = strchr( comment, ']' )))
+	{
+		*p = 0;
+		type = comment + 1;      // quick, autosave...
+		title = p + 1;
+	}
+
+	// strip trailing spaces
+	for( int len = (int)strlen( title ) - 1; len >= 0 && isspace( (unsigned char)title[len] ); len-- )
+		title[len] = 0;
+
+	const char *shown = title;
+	if( title[0] == '#' )
+	{
+		char *sp = strchr( title, ' ' );
+		if( sp ) *sp = 0;
+		shown = L( title );
+	}
+
+	if( type && !stricmp( type, "quick" ))
+		snprintf( out->title, sizeof( out->title ), "%s  -  %s", L( "Quick save" ), shown );
+	else if( type && !stricmp( type, "autosave" ))
+		snprintf( out->title, sizeof( out->title ), "%s  -  %s", L( "Autosave" ), shown );
+	else
+		snprintf( out->title, sizeof( out->title ), "%s", shown );
+
+	return true;
+}
+
+void CMenuXbSaves::Refresh()
+{
+	int numFiles = 0;
+	char **files = EngFuncs::GetFilesList( "save/*.sav", &numFiles, true );
+	int prev = list.cur;
+
+	list.count = 0;
+
+	if( saveMode && CL_IsActive( ))
+	{
+		xbSave_t &n = list.saves[list.count++];
+		memset( &n, 0, sizeof( n ));
+		Q_strncpy( n.title, L( "+  New save" ), sizeof( n.title ));
+	}
+
+	if( files && numFiles > 0 )
+	{
+		qsort( files, numFiles, sizeof( *files ), XB_CompareSaves );
+		for( int i = 0; i < numFiles && list.count < XB_SAVES_MAX; i++ )
+		{
+			if( XB_ReadSave( files[i], &list.saves[list.count] ))
+				list.count++;
+		}
+	}
+
+	list.cur = list.count ? Q_min( Q_max( prev, 0 ), list.count - 1 ) : 0;
+	if( list.cur < list.top || list.cur >= list.top + XB_SAVES_VISIBLE )
+		list.top = Q_max( 0, list.cur - XB_SAVES_VISIBLE + 1 );
+	Selected();
+}
+
+const xbSave_t *CMenuXbSaves::Current() const
+{
+	if( list.cur < 0 || list.cur >= list.count )
+		return NULL;
+	return &list.saves[list.cur];
+}
+
+void CMenuXbSaves::Selected()
+{
+	const xbSave_t *s = Current();
+
+	// the hints follow what the selected row can do
+	if( !s )
+		xbHints = L( "(B) Back" );
+	else if( !s->name[0] )
+		xbHints = L( "(A) Save     (B) Back" );
+	else if( saveMode )
+		xbHints = L( "(A) Load   (Y) Save here   (X) Delete   (B) Back" );
+	else
+		xbHints = L( "(A) Load     (X) Delete     (B) Back" );
+
+	if( !s || !s->name[0] )
+	{
+		shot.ForceUnload();
+		shotName[0] = 0;
+		list.szStatusText = s ? L( "Save your progress as a new save" ) : NULL;
+		return;
+	}
+
+	list.szStatusText = saveMode ? L( "During play, quick save with View + D-pad Up. Load it again with View + D-pad Down." )
+		: L( "Choose a save and press A to load it. During play, View + D-pad Up quick saves." );
+
+	if( strcmp( shotName, s->name ))
+	{
+		char path[128];
+		snprintf( path, sizeof( path ), "save/%s.bmp", s->name );
+		shot.ForceUnload();
+		if( EngFuncs::FileExists( path, true ))
+			shot.Load( path );
+		Q_strncpy( shotName, s->name, sizeof( shotName ));
+	}
+}
+
+void CMenuXbSaves::LoadCb()
+{
+	const xbSave_t *s = Current();
+	if( !s || !s->name[0] )
+		return;
+
+	char cmd[128];
+	snprintf( cmd, sizeof( cmd ), "load \"%s\"\n", s->name );
+	EngFuncs::StopBackgroundTrack( );
+	EngFuncs::ClientCmd( false, cmd );
+	UI_CloseMenu();
+}
+
+void CMenuXbSaves::SaveNewCb()
+{
+	// "new": the engine picks the next free name
+	EngFuncs::ClientCmd( false, "save \"new\"\n" );
+	UI_CloseMenu();
+}
+
+void CMenuXbSaves::SaveOverCb()
+{
+	const xbSave_t *s = Current();
+	if( !s || !s->name[0] )
+		return;
+
+	char cmd[128];
+	snprintf( cmd, sizeof( cmd ), "save/%s.bmp", s->name );
+	EngFuncs::PIC_Free( cmd );
+	snprintf( cmd, sizeof( cmd ), "save \"%s\"\n", s->name );
+	EngFuncs::ClientCmd( false, cmd );
+	UI_CloseMenu();
+}
+
+void CMenuXbSaves::DeleteCb()
+{
+	const xbSave_t *s = Current();
+	if( !s || !s->name[0] )
+		return;
+
+	char cmd[128];
+	snprintf( cmd, sizeof( cmd ), "save/%s.bmp", s->name );
+	EngFuncs::PIC_Free( cmd );
+	shot.ForceUnload();
+	shotName[0] = 0;
+	snprintf( cmd, sizeof( cmd ), "killsave \"%s\"\n", s->name );
+	EngFuncs::ClientCmd( true, cmd );
+	Refresh();
+}
+
+bool CMenuXbSaves::KeyDown( int key )
+{
+	if( dialog.IsVisible( ))
+		return BaseClass::KeyDown( key );
+
+	if( UI::Key::IsEnter( key ) || key == K_X_BUTTON || key == K_Y_BUTTON || key == K_DEL )
+	{
+		pressed = key;
+		return true;
+	}
+
+	bool r = BaseClass::KeyDown( key );
+	Selected();
+	return r;
+}
+
+bool CMenuXbSaves::KeyUp( int key )
+{
+	if( dialog.IsVisible( ) || key != pressed )
+		return BaseClass::KeyUp( key );
+
+	pressed = 0;
+	const xbSave_t *s = Current();
+	if( !s )
+		return true;
+
+	if( UI::Key::IsEnter( key ))
+	{
+		PlayLocalSound( uiStatic.sounds[SND_LAUNCH] );
+		if( !s->name[0] )
+			SaveNewCb();
+		else
+			LoadCb();
+	}
+	else if( key == K_Y_BUTTON && saveMode && s->name[0] )
+	{
+		dialog.onPositive = VoidCb( &CMenuXbSaves::SaveOverCb );
+		dialog.SetMessage( L( "Save over this game?" ));
+		dialog.Show();
+	}
+	else if(( key == K_X_BUTTON || key == K_DEL ) && s->name[0] )
+	{
+		dialog.onPositive = VoidCb( &CMenuXbSaves::DeleteCb );
+		dialog.SetMessage( L( "Delete this saved game?" ));
+		dialog.Show();
+	}
+	return true;
+}
+
+void CMenuXbSaves::_Init()
+{
+	list.SetRect( 72, 150, 520, XB_SAVES_VISIBLE * 58 );
+	dialog.Link( this );
+	shotName[0] = 0;
+	pressed = 0;
+
+	AddItem( banner );
+	AddItem( list );
+}
+
+void CMenuXbSaves::_VidInit()
+{
+	banner.szName = saveMode && CL_IsActive( ) ? L( "Save / Load Game" ) : L( "Load Game" );
+}
+
+void CMenuXbSaves::Reload()
+{
+	BaseClass::Reload();
+	Refresh();
+}
+
+void CMenuXbSaves::Draw()
+{
+	BaseClass::Draw();
+
+	// the selected save's screenshot, right of the list
+	int x = ( 620 * uiStatic.scaleX ) + uiStatic.xOffset;
+	int y = ( 150 * uiStatic.scaleY ) + uiStatic.yOffset;
+	int w = 340 * uiStatic.scaleX;
+	int h = w * 3 / 4;
+
+	if( shot.IsValid( ))
+	{
+		UI_FillRect( x - 3, y - 3, w + 6, h + 6, PackRGBA( 255, 165, 0, 160 ));
+		UI_DrawPic( x, y, w, h, uiColorWhite, shot );
+	}
+}
+
+static CMenuXbSaves *menu_xbsaves = NULL;
+
+static void UI_XboxSaves_Precache( void )
+{
+	menu_xbsaves = new CMenuXbSaves();
+}
+
+static void UI_XboxSaves_Shutdown( void )
+{
+	delete menu_xbsaves;
+}
+
+void UI_XboxLoad_Menu( void )
+{
+	if( EngFuncs::CheckGameDll( ))
+		menu_xbsaves->Open( false );
+}
+
+void UI_XboxSaveLoad_Menu( void )
+{
+	if( EngFuncs::CheckGameDll( ))
+		menu_xbsaves->Open( true );
+}
+
+ADD_MENU4( menu_xboxsaves, UI_XboxSaves_Precache, UI_XboxSaveLoad_Menu, UI_XboxSaves_Shutdown );
+
+#endif // XASH_UWP
