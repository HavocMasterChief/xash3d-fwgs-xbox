diff --git a/menus/XboxController.cpp b/menus/XboxController.cpp
new file mode 100644
index 0000000..eba303f
--- /dev/null
+++ b/menus/XboxController.cpp
@@ -0,0 +1,126 @@
+/*
+XboxController.cpp - controller settings menu for the Xbox build
+Copyright (C) 2026 HavocMasterChief
+
+This program is free software; you can redistribute it and/or
+modify it under the terms of the GNU General Public License
+as published by the Free Software Foundation; either version 2
+of the License, or (at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+See the GNU General Public License for more details.
+
+Replaces the keyboard/mouse "Controls" screen: a picture of the
+controller with what each button does, plus the controller options.
+The cvars live in the engine (engine/client/input/in_joy.c).
+*/
+
+#if XASH_UWP
+
+#include "Framework.h"
+#include "Bitmap.h"
+#include "PicButton.h"
+#include "Slider.h"
+#include "CheckBox.h"
+#include "SpinControl.h"
+#include "StringArrayModel.h"
+
+#define ART_BANNER     "gfx/shell/head_gamepad"
+#define ART_CONTROLLER "gfx/shell/xbox_controller.png"
+
+class CMenuXboxController : public CMenuFramework
+{
+public:
+	typedef CMenuFramework BaseClass;
+	CMenuXboxController() : CMenuFramework( "CMenuXboxController" ) { }
+
+private:
+	void _Init() override;
+	void _VidInit() override;
+	void SaveAndPopMenu() override;
+
+	CMenuBitmap   picture;
+	CMenuSlider   lookSens;
+	CMenuSpinControl aimAssist;
+	CMenuCheckBox invertLook;
+	CMenuCheckBox toggleCrouch;
+	CMenuCheckBox quickTurn;
+	CMenuCheckBox autoAim;
+};
+
+void CMenuXboxController::SaveAndPopMenu()
+{
+	lookSens.WriteCvar();
+	aimAssist.WriteCvar();
+	invertLook.WriteCvar();
+	toggleCrouch.WriteCvar();
+	quickTurn.WriteCvar();
+	autoAim.WriteCvar();
+
+	CMenuFramework::SaveAndPopMenu();
+}
+
+void CMenuXboxController::_Init()
+{
+	static const char *aimAssistNames[] = { "Off", "Low", "Medium", "High" };
+	static CStringArrayModel aimAssistModel( aimAssistNames, V_ARRAYSIZE( aimAssistNames ));
+
+	banner.SetPicture( ART_BANNER );
+
+	picture.SetPicture( ART_CONTROLLER );
+	picture.iFlags = QMF_INACTIVE;
+	picture.SetRect( 330, 150, 660, 330 );
+
+	lookSens.SetNameAndStatus( L( "Look sensitivity" ), L( "How fast the right stick turns the view" ));
+	lookSens.Setup( 0.25f, 3.0f, 0.05f );
+	lookSens.onChanged = CMenuEditable::WriteCvarCb;
+	lookSens.SetCoord( 330, 540 );
+	lookSens.size.w = 300;
+
+	aimAssist.SetNameAndStatus( L( "Aim assist" ), L( "Slows and nudges your aim when it crosses an enemy" ));
+	aimAssist.Setup( &aimAssistModel );
+	aimAssist.onChanged = CMenuEditable::WriteCvarCb;
+	aimAssist.SetRect( 700, 540, 260, 32 );
+
+	invertLook.SetNameAndStatus( L( "Invert look" ), L( "Push the right stick up to look down" ));
+	invertLook.onChanged = CMenuEditable::WriteCvarCb;
+	invertLook.SetCoord( 330, 610 );
+
+	toggleCrouch.SetNameAndStatus( L( "Toggle crouch" ), L( "Press B once to crouch, again to stand, instead of holding it" ));
+	toggleCrouch.onChanged = CMenuEditable::WriteCvarCb;
+	toggleCrouch.SetCoord( 560, 610 );
+
+	quickTurn.SetNameAndStatus( L( "Quick turn" ), L( "Turning speeds up when the right stick is held fully sideways" ));
+	quickTurn.onChanged = CMenuEditable::WriteCvarCb;
+	quickTurn.SetCoord( 790, 610 );
+
+	autoAim.SetNameAndStatus( L( "Auto-aim" ), L( "Half-Life's own auto-aim: shots bend slightly toward enemies" ));
+	autoAim.onChanged = CMenuEditable::WriteCvarCb;
+	autoAim.SetCoord( 330, 670 );
+
+	AddItem( banner );
+	AddButton( L( "Done" ), L( "Go back to the previous menu" ), PC_DONE, VoidCb( &CMenuXboxController::SaveAndPopMenu ), QMF_NOTIFY );
+	AddItem( picture );
+	AddItem( lookSens );
+	AddItem( aimAssist );
+	AddItem( invertLook );
+	AddItem( toggleCrouch );
+	AddItem( quickTurn );
+	AddItem( autoAim );
+}
+
+void CMenuXboxController::_VidInit()
+{
+	lookSens.LinkCvar( "joy_look_sens" );
+	aimAssist.LinkCvar( "joy_aimassist", CMenuEditable::CVAR_VALUE );
+	invertLook.LinkCvar( "joy_invert" );
+	toggleCrouch.LinkCvar( "joy_crouch_toggle" );
+	quickTurn.LinkCvar( "joy_quickturn" );
+	autoAim.LinkCvar( "sv_aim" );
+}
+
+ADD_MENU( menu_xbox_controller, CMenuXboxController, UI_XboxController_Menu );
+
+#endif // XASH_UWP
diff --git a/menus/XboxGameplay.cpp b/menus/XboxGameplay.cpp
new file mode 100644
index 0000000..cc4faa4
--- /dev/null
+++ b/menus/XboxGameplay.cpp
@@ -0,0 +1,81 @@
+/*
+XboxGameplay.cpp - gameplay options for the Xbox build
+Copyright (C) 2026 HavocMasterChief
+
+This program is free software; you can redistribute it and/or
+modify it under the terms of the GNU General Public License
+as published by the Free Software Foundation; either version 2
+of the License, or (at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+See the GNU General Public License for more details.
+
+Blood mode (xb_blood, game DLL dlls/xb_gore.cpp) and controller vibration.
+*/
+
+#if XASH_UWP
+
+#include "Framework.h"
+#include "PicButton.h"
+#include "CheckBox.h"
+#include "SpinControl.h"
+#include "StringArrayModel.h"
+
+#define ART_BANNER "gfx/shell/head_config"
+
+class CMenuXboxGameplay : public CMenuFramework
+{
+public:
+	typedef CMenuFramework BaseClass;
+	CMenuXboxGameplay() : CMenuFramework( "CMenuXboxGameplay" ) { }
+
+private:
+	void _Init() override;
+	void _VidInit() override;
+	void SaveAndPopMenu() override;
+
+	CMenuSpinControl blood;
+	CMenuCheckBox vibration;
+};
+
+void CMenuXboxGameplay::SaveAndPopMenu()
+{
+	blood.WriteCvar();
+	vibration.WriteCvar();
+	CMenuFramework::SaveAndPopMenu();
+}
+
+void CMenuXboxGameplay::_Init()
+{
+	static const char *bloodNames[] = { "Disabled", "Default", "Green", "Extreme" };
+	static CStringArrayModel bloodModel( bloodNames, V_ARRAYSIZE( bloodNames ));
+
+	banner.SetPicture( ART_BANNER );
+
+	blood.SetNameAndStatus( L( "Blood" ),
+		L( "Default: pools under bodies. Green: alien-coloured blood. Extreme: spurts, wall runs, ceiling drips, blood on screen" ));
+	blood.Setup( &bloodModel );
+	blood.onChanged = CMenuEditable::WriteCvarCb;
+	blood.SetRect( 330, 280, 300, 32 );
+
+	vibration.SetNameAndStatus( L( "Controller vibration" ), L( "Rumble when firing, taking damage and from explosions" ));
+	vibration.onChanged = CMenuEditable::WriteCvarCb;
+	vibration.SetCoord( 330, 360 );
+
+	AddItem( banner );
+	AddButton( L( "Done" ), L( "Go back to the previous menu" ), PC_DONE, VoidCb( &CMenuXboxGameplay::SaveAndPopMenu ), QMF_NOTIFY );
+	AddItem( blood );
+	AddItem( vibration );
+}
+
+void CMenuXboxGameplay::_VidInit()
+{
+	blood.LinkCvar( "xb_blood", CMenuEditable::CVAR_VALUE );
+	vibration.LinkCvar( "vibration_enable" );
+}
+
+ADD_MENU( menu_xbox_gameplay, CMenuXboxGameplay, UI_XboxGameplay_Menu );
+
+#endif // XASH_UWP
