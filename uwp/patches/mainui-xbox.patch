+/*
+=================
+XB_NewestSave
+
+The most recent save of any kind (quick, auto or manual), for Continue
+=================
+*/
+static bool XB_NewestSave( char *out, size_t size )
+{
+	int numFiles = 0;
+	char **files = EngFuncs::GetFilesList( "save/*.sav", &numFiles, true );
+	const char *best = NULL;
+
+	for( int i = 0; i < numFiles; i++ )
+	{
+		char comment[256];
+
+		// skip corrupted and old-version saves
+		if( !EngFuncs::GetSaveComment( files[i], comment ))
+			continue;
+
+		int newer = 0;
+		if( best )
+			EngFuncs::CompareFileTime( files[i], best, &newer );
+		if( !best || newer > 0 )
+			best = files[i];
+	}
+
+	if( !best )
+		return false;
+
+	COM_FileBase( best, out, size );
+	return true;
+}
+#endif
