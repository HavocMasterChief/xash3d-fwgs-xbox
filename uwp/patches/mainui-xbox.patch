+Settings
+  Controller   layout picture, look sensitivity, aim assist, invert,
+               toggle crouch, quick turn, auto-aim, vibration
+  Gameplay     blood, ragdolls
+  Audio        game, music and HEV suit volume, room echo
+  Video        gamma, brightness, detail textures, overbrights, filtering
+
+Every screen is a list of CMenuXbRow (XboxRows.cpp): one setting per row,
+changed with left/right, written at once. B or Back saves the config.
+*/
+
+#if XASH_UWP
+
+#include "Framework.h"
+#include "Bitmap.h"
+#include "XboxRows.h"
+
+#define XB_ROWS_TOP 150
+#define XB_MAX_ROWS 12
+
+/*
+=================
+CMenuXbScreen
+
+A titled screen of rows. Leaving it (B or the Back row) writes config.cfg.
+=================
+*/
+class CMenuXbScreen : public CMenuFramework
+{
+public:
+	typedef CMenuFramework BaseClass;
+	CMenuXbScreen( const char *name ) : CMenuFramework( name ), numRows( 0 ), title( NULL ) { }
+
+	void Hide() override
+	{
+		EngFuncs::ClientCmd( false, "host_writeconfig\n" );
+		BaseClass::Hide();
+	}
+
+protected:
+	CMenuXbRow *NewRow()
+	{
+		return &rows[numRows++];
+	}
+
+	void BackRow()
+	{
+		CMenuXbRow *r = NewRow();
+		r->SetupButton( L( "Back" ), L( "Go back to the previous menu" ), VoidCb( &CMenuXbScreen::Hide ));
+	}
+
+	// call at the end of _Init
+	void AddRows( int top = XB_ROWS_TOP )
+	{
+		CMenuXbRow *list[XB_MAX_ROWS];
+		for( int i = 0; i < numRows; i++ )
+			list[i] = &rows[i];
+		XbRows_Layout( list, numRows, top );
+
+		if( title )
+			banner.szName = title;
+		AddItem( banner );
+		for( int i = 0; i < numRows; i++ )
+			AddItem( rows[i] );
+	}
+
+	CMenuXbRow rows[XB_MAX_ROWS];
+	int numRows;
+	const char *title;
+};
+
+/*
+=================
+Controller layout: just the picture
+=================
+*/
+class CMenuXbLayout : public CMenuXbScreen
+{
+public:
+	CMenuXbLayout() : CMenuXbScreen( "CMenuXbLayout" ) { }
+private:
+	void _Init() override
+	{
+		title = L( "Controller layout" );
+
+		picture.SetPicture( "gfx/shell/xbox_controller.png" );
+		picture.iFlags = QMF_INACTIVE;
+		picture.SetRect( 72, 130, 880, 440 );
+
+		BackRow();
+		AddRows( 600 );
+		AddItem( picture );
+	}
+	CMenuBitmap picture;
+};
+ADD_MENU( menu_xbox_layout, CMenuXbLayout, UI_XboxLayout_Menu );
+
+/*
+=================
+Controller
+=================
+*/
+class CMenuXbController : public CMenuXbScreen
+{
+public:
+	CMenuXbController() : CMenuXbScreen( "CMenuXbController" ) { }
+private:
+	void _Init() override
+	{
+		static const char *aimNames[] = { "Off", "Low", "Medium", "High" };
+
+		title = L( "Controller" );
+
+		NewRow()->SetupButton( L( "Controller layout" ), L( "See what every button does" ), UI_XboxLayout_Menu );
+		NewRow()->SetupSlider( L( "Look sensitivity" ), L( "How fast the right stick turns the view" ), "joy_look_sens", 0.25f, 3.0f, 0.05f, false );
+		NewRow()->SetupList( L( "Aim assist" ), L( "Slows and nudges your aim when it crosses an enemy" ), "joy_aimassist", aimNames, NULL, 4 );
+		NewRow()->SetupToggle( L( "Invert look" ), L( "Push the right stick up to look down" ), "joy_invert" );
+		NewRow()->SetupToggle( L( "Toggle crouch" ), L( "Press B once to crouch and again to stand, instead of holding it" ), "joy_crouch_toggle" );
+		NewRow()->SetupToggle( L( "Quick turn" ), L( "Turning speeds up when the right stick is held fully sideways" ), "joy_quickturn" );
+		NewRow()->SetupToggle( L( "Auto-aim" ), L( "Half-Life's own auto-aim: shots bend slightly toward enemies" ), "sv_aim" );
+		NewRow()->SetupToggle( L( "Vibration" ), L( "Rumble when firing, taking damage and from explosions" ), "vibration_enable" );
+		BackRow();
+		AddRows();
+	}
+};
+ADD_MENU( menu_xbox_controller, CMenuXbController, UI_XboxController_Menu );
+
+/*
+=================
+Gameplay
+=================
+*/
+class CMenuXbGameplay : public CMenuXbScreen
+{
+public:
+	CMenuXbGameplay() : CMenuXbScreen( "CMenuXbGameplay" ) { }
+private:
+	void _Init() override
+	{
+		static const char *bloodNames[] = { "Disabled", "Default", "Green", "Extreme" };
+
+		title = L( "Gameplay" );
+
+		NewRow()->SetupList( L( "Blood" ),
+			L( "Default: droplets and pools. Green: alien-coloured. Extreme: spurts, wall runs, drips, blood on screen" ),
+			"xb_blood", bloodNames, NULL, 4 );
+		NewRow()->SetupToggle( L( "Ragdolls" ), L( "Bodies fall and tumble with physics instead of playing a death animation" ), "xb_ragdoll" );
+		BackRow();
+		AddRows();
+	}
+};
+ADD_MENU( menu_xbox_gameplay, CMenuXbGameplay, UI_XboxGameplay_Menu );
+
+/*
+=================
+Audio
+=================
+*/
+class CMenuXbAudio : public CMenuXbScreen
+{
+public:
