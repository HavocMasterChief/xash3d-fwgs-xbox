+#include "XboxRows.h"
+
+#include <math.h>
+#include <stdio.h>
+
+// colours: Half-Life orange on dark glass
+#define XB_ROW_BG        PackRGBA( 0, 0, 0, 120 )
+#define XB_ROW_BG_FOCUS  PackRGBA( 255, 150, 0, 60 )
+#define XB_ROW_ACCENT    PackRGBA( 255, 165, 0, 255 )
+#define XB_TEXT          PackRGBA( 215, 215, 215, 255 )
+#define XB_TEXT_FOCUS    PackRGBA( 255, 200, 90, 255 )
+#define XB_TEXT_GRAY     PackRGBA( 110, 110, 110, 255 )
+#define XB_BAR_BG        PackRGBA( 60, 60, 60, 200 )
+#define XB_BAR_FILL      PackRGBA( 255, 160, 0, 230 )
+
+CMenuXbRow::CMenuXbRow() : BaseClass()
+{
+	kind = BUTTON;
+	cvar = NULL;
+	inverted = percent = false;
+	names = NULL;
+	values = NULL;
+	count = 0;
+	value = vmin = 0.0f;
+	vmax = vstep = 1.0f;
+	pressed = false;
+	charSize = UI_MED_CHAR_HEIGHT;
+	size.w = ROW_W;
+	size.h = ROW_H;
+}
+
+void CMenuXbRow::SetupButton( const char *name, const char *status, CEventCallback cb )
+{
+	SetNameAndStatus( name, status );
+	kind = BUTTON;
+	onActivate = cb;
+}
+
+void CMenuXbRow::SetupToggle( const char *name, const char *status, const char *cv, bool inv )
+{
+	SetNameAndStatus( name, status );
+	kind = TOGGLE;
+	cvar = cv;
+	inverted = inv;
+}
+
+void CMenuXbRow::SetupList( const char *name, const char *status, const char *cv, const char **n, const float *v, int c )
+{
+	SetNameAndStatus( name, status );
+	kind = LIST;
+	cvar = cv;
+	names = n;
+	values = v;
+	count = c;
+}
+
+void CMenuXbRow::SetupSlider( const char *name, const char *status, const char *cv, float mn, float mx, float st, bool pct )
+{
+	SetNameAndStatus( name, status );
+	kind = SLIDER;
+	cvar = cv;
+	vmin = mn;
+	vmax = mx;
+	vstep = st;
+	percent = pct;
+}
+
+void CMenuXbRow::ReadCvar()
+{
+	if( cvar )
+		value = EngFuncs::GetCvarFloat( cvar );
+}
+
+void CMenuXbRow::WriteCvar()
+{
+	if( cvar )
+		EngFuncs::CvarSetValue( cvar, value );
+}
+
+int CMenuXbRow::ValueIndex() const
+{
+	int best = 0;
+	float bestDist = 1e9f;
+
+	for( int i = 0; i < count; i++ )
+	{
+		float v = values ? values[i] : (float)i;
+		float d = fabs( v - value );
+		if( d < bestDist ) { bestDist = d; best = i; }
+	}
+	return best;
+}
+
+void CMenuXbRow::VidInit()
+{
+	BaseClass::VidInit();
+	ReadCvar();
+}
+
+void CMenuXbRow::Reload()
+{
+	BaseClass::Reload();
+	ReadCvar();
+}
+
+void CMenuXbRow::Change( int dir )
+{
+	switch( kind )
+	{
+	case TOGGLE:
+		value = ( value != 0.0f ) ? 0.0f : 1.0f;
+		break;
+	case LIST:
+	{
+		int i = ( ValueIndex() + dir + count ) % count;
+		value = values ? values[i] : (float)i;
+		break;
+	}
+	case SLIDER:
+	{
+		float v = value + dir * vstep;
+		v = floorf( v / vstep + 0.5f ) * vstep;
+		if( v < vmin ) v = vmin;
+		if( v > vmax ) v = vmax;
+		if( v == value )
+			return; // already at the end: no sound
+		value = v;
+		break;
+	}
+	default:
+		return;
+	}
+
+	WriteCvar();
+	PlayLocalSound( uiStatic.sounds[SND_MOVE] );
+	_Event( QM_CHANGED );
+}
+
+bool CMenuXbRow::KeyDown( int key )
+{
+	if( UI::Key::IsLeftArrow( key ) || UI::Key::IsRightArrow( key ))
+	{
+		if( kind == BUTTON )
+			return false;
+		Change( UI::Key::IsLeftArrow( key ) ? -1 : 1 );
+		return true;
+	}
+
+	if( UI::Key::IsEnter( key ))
+	{
+		pressed = true;
+		return true;
+	}
+
+	return false;
+}
+
+bool CMenuXbRow::KeyUp( int key )
+{
+	if( UI::Key::IsLeftArrow( key ) || UI::Key::IsRightArrow( key ))
+		return kind != BUTTON;
+
+	if( !UI::Key::IsEnter( key ))
+		return false;
+
+	// only a press that started on this row counts, so the release of the
+	// A that opened this menu can't also pick something in it
+	if( !pressed )
+		return true;
+	pressed = false;
+
+	if( kind == BUTTON )
+	{
+		PlayLocalSound( uiStatic.sounds[SND_LAUNCH] );
+		onActivate( this );
+	}
+	else if( kind == TOGGLE || kind == LIST )
+	{
+		Change( 1 );
+	}
+	return true;
+}
+
+void CMenuXbRow::Draw()
+{
+	bool focus = ( iFlags & ( QMF_HASKEYBOARDFOCUS | QMF_HASMOUSEFOCUS )) != 0;
+	bool grayed = ( iFlags & QMF_GRAYED ) != 0;
+	unsigned int textCol = grayed ? XB_TEXT_GRAY : ( focus ? XB_TEXT_FOCUS : XB_TEXT );
+	int pad = 16 * uiStatic.scaleX;
+
+	if( !focus )
+		pressed = false;
+
+	// the row
+	UI_FillRect( m_scPos, m_scSize, focus ? XB_ROW_BG_FOCUS : XB_ROW_BG );
+	if( focus )
+		UI_FillRect( m_scPos.x, m_scPos.y, 6 * uiStatic.scaleX, m_scSize.h, XB_ROW_ACCENT );
+
+	// label, left
+	Point lp( m_scPos.x + pad, m_scPos.y );
+	Size ls( m_scSize.w * 0.55f - pad, m_scSize.h );
+	UI_DrawString( font, lp, ls, szName, textCol, m_scChSize, QM_LEFT, ETF_SHADOW | ETF_NOSIZELIMIT | ETF_FORCECOL );
+
+	if( kind == BUTTON )
+	{
+		// a chevron says "opens something"
+		Point vp( m_scPos.x + m_scSize.w * 0.55f, m_scPos.y );
+		Size vs( m_scSize.w * 0.45f - pad, m_scSize.h );
+		UI_DrawString( font, vp, vs, ">", textCol, m_scChSize, QM_RIGHT, ETF_SHADOW | ETF_NOSIZELIMIT | ETF_FORCECOL );
+		return;
+	}
+
+	// value, right half of the same row
+	Point vp( m_scPos.x + m_scSize.w * 0.55f, m_scPos.y );
+	Size vs( m_scSize.w * 0.45f - pad, m_scSize.h );
+	char buf[64];
+
+	if( kind == SLIDER )
+	{
+		float frac = ( vmax > vmin ) ? ( value - vmin ) / ( vmax - vmin ) : 0.0f;
+		if( frac < 0.0f ) frac = 0.0f;
+		if( frac > 1.0f ) frac = 1.0f;
+
+		if( percent )
+			snprintf( buf, sizeof( buf ), "%d%%", (int)( frac * 100.0f + 0.5f ));
+		else
+			snprintf( buf, sizeof( buf ), "%.2f", value );
+
+		int numW = 70 * uiStatic.scaleX;
+		int barH = 10 * uiStatic.scaleY;
+		Point bp( vp.x, m_scPos.y + ( m_scSize.h - barH ) / 2 );
+		Size bs( vs.w - numW - 12 * uiStatic.scaleX, barH );
+
+		UI_FillRect( bp, bs, XB_BAR_BG );
+		UI_FillRect( bp.x, bp.y, bs.w * frac, bs.h, grayed ? XB_TEXT_GRAY : XB_BAR_FILL );
+
+		Point np( vp.x + vs.w - numW, m_scPos.y );
+		Size ns( numW, m_scSize.h );
+		UI_DrawString( font, np, ns, buf, textCol, m_scChSize, QM_RIGHT, ETF_SHADOW | ETF_NOSIZELIMIT | ETF_FORCECOL );
+		return;
+	}
+
+	const char *text;
+	if( kind == TOGGLE )
+		text = (( value != 0.0f ) != inverted ) ? L( "On" ) : L( "Off" );
+	else
+		text = ( count > 0 ) ? names[ValueIndex()] : "";
+
+	// arrows only on the selected row, where left/right do something
+	if( focus )
+		snprintf( buf, sizeof( buf ), "<  %s  >", text );
+	else
+		snprintf( buf, sizeof( buf ), "%s", text );
+
+	UI_DrawString( font, vp, vs, buf, textCol, m_scChSize, QM_RIGHT, ETF_SHADOW | ETF_NOSIZELIMIT | ETF_FORCECOL );
+}
+
+int XbRows_Layout( CMenuXbRow **rows, int count, int y )
+{
+	for( int i = 0; i < count; i++ )
+	{
+		rows[i]->SetRect( CMenuXbRow::ROW_X, y, CMenuXbRow::ROW_W, CMenuXbRow::ROW_H );
+		y += CMenuXbRow::ROW_H + CMenuXbRow::ROW_GAP;
+	}
+	return y;
+}
+
+#endif // XASH_UWP
diff --git a/menus/XboxRows.h b/menus/XboxRows.h
new file mode 100644
index 0000000..026b75d
--- /dev/null
+++ b/menus/XboxRows.h
@@ -0,0 +1,84 @@
+/*
+XboxRows.h - controller-friendly settings rows for the Xbox build
+Copyright (C) 2026 HavocMasterChief
+
+This program is free software; you can redistribute it and/or
+modify it under the terms of the GNU General Public License
+as published by the Free Software Foundation; either version 2
+of the License, or (at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+See the GNU General Public License for more details.
+
+One setting per full-width row: the label on the left, the value on the
+right of the same row ("Aim assist   < Medium >"). Up/down moves between
+rows, left/right changes the value, A toggles or opens, B goes back. The
+selected row is highlighted, and its description shows in the fixed bar
+at the bottom of the screen (CMenuFramework::Draw), never over a setting.
+
+Values are written to the cvar the moment they change.
+*/
+
+#pragma once
+#ifndef XBOX_ROWS_H
+#define XBOX_ROWS_H
+
+#if XASH_UWP
+
+#include "BaseItem.h"
+
+class CMenuXbRow : public CMenuBaseItem
+{
+public:
+	typedef CMenuBaseItem BaseClass;
+
+	enum Kind { BUTTON, TOGGLE, LIST, SLIDER };
+
+	CMenuXbRow();
+
+	// A opens/does something
+	void SetupButton( const char *name, const char *status, CEventCallback cb );
+	// On/Off; inverted: the cvar is 1 when the row reads Off
+	void SetupToggle( const char *name, const char *status, const char *cvar, bool inverted = false );
+	// one of several names; values[] are the cvar values (NULL: 0, 1, 2...)
+	void SetupList( const char *name, const char *status, const char *cvar, const char **names, const float *values, int count );
+	// a bar from min to max; percent shows 0-100% instead of the number
+	void SetupSlider( const char *name, const char *status, const char *cvar, float min, float max, float step, bool percent );
+
+	void VidInit() override;
+	void Reload() override;
+	bool KeyDown( int key ) override;
+	bool KeyUp( int key ) override;
+	void Draw() override;
+
+	CEventCallback onActivate;
+
+	// rows are laid out top to bottom from here, ROW_H apart
+	static const int ROW_X = 72;
+	static const int ROW_W = 620;
+	static const int ROW_H = 46;
+	static const int ROW_GAP = 6;
+
+private:
+	void Change( int dir );
+	void ReadCvar();
+	void WriteCvar();
+	int ValueIndex() const;
+
+	Kind kind;
+	const char *cvar;
+	bool inverted, percent;
+	const char **names;
+	const float *values;
+	int count;
+	float value, vmin, vmax, vstep;
+	bool pressed;
+};
+
+// place rows one under another starting at y; returns the y after the last one
+int XbRows_Layout( CMenuXbRow **rows, int count, int y );
+
+#endif // XASH_UWP
+#endif // XBOX_ROWS_H
diff --git a/menus/XboxSettings.cpp b/menus/XboxSettings.cpp
new file mode 100644
index 0000000..4e2014a
--- /dev/null
+++ b/menus/XboxSettings.cpp
@@ -0,0 +1,242 @@
+/*
+XboxSettings.cpp - the Xbox build's Settings menus
+Copyright (C) 2026 HavocMasterChief
+
+This program is free software; you can redistribute it and/or
+modify it under the terms of the GNU General Public License
+as published by the Free Software Foundation; either version 2
+of the License, or (at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+See the GNU General Public License for more details.
+
+Settings
+  Controller   layout picture, look sensitivity, aim assist, invert,
+               toggle crouch, quick turn, auto-aim, vibration
+  Gameplay     blood, ragdolls
+  Audio        game, music and HEV suit volume, room echo
+  Video        gamma, brightness, detail textures, overbrights, filtering
+
+Every screen is a list of CMenuXbRow (XboxRows.cpp): one setting per row,
+changed with left/right, written at once. B or Back saves the config.
+*/
+
+#if XASH_UWP
+
+#include "Framework.h"
+#include "Bitmap.h"
+#include "XboxRows.h"
+
+#define XB_ROWS_TOP 150
+#define XB_MAX_ROWS 12
+
+/*
+=================
+CMenuXbScreen
+
+A titled screen of rows. Leaving it (B or the Back row) writes config.cfg.
+=================
+*/
+class CMenuXbScreen : public CMenuFramework
+{
+public:
+	typedef CMenuFramework BaseClass;
+	CMenuXbScreen( const char *name ) : CMenuFramework( name ), numRows( 0 ), title( NULL ) { }
+
+	void Hide() override
+	{
+		EngFuncs::ClientCmd( false, "host_writeconfig\n" );
+		BaseClass::Hide();
+	}
+
+protected:
+	CMenuXbRow *NewRow()
+	{
+		return &rows[numRows++];
+	}
+
+	void BackRow()
+	{
+		CMenuXbRow *r = NewRow();
+		r->SetupButton( L( "Back" ), L( "Go back to the previous menu" ), VoidCb( &CMenuXbScreen::Hide ));
+	}
+
+	// call at the end of _Init
+	void AddRows( int top = XB_ROWS_TOP )
+	{
+		CMenuXbRow *list[XB_MAX_ROWS];
+		for( int i = 0; i < numRows; i++ )
+			list[i] = &rows[i];
+		XbRows_Layout( list, numRows, top );
+
+		if( title )
+			banner.szName = title;
+		AddItem( banner );
+		for( int i = 0; i < numRows; i++ )
+			AddItem( rows[i] );
+	}
+
+	CMenuXbRow rows[XB_MAX_ROWS];
+	int numRows;
+	const char *title;
+};
+
+/*
+=================
+Controller layout: just the picture
+=================
+*/
+class CMenuXbLayout : public CMenuXbScreen
+{
+public:
+	CMenuXbLayout() : CMenuXbScreen( "CMenuXbLayout" ) { }
+private:
+	void _Init() override
+	{
+		title = L( "Controller layout" );
+
+		picture.SetPicture( "gfx/shell/xbox_controller.png" );
+		picture.iFlags = QMF_INACTIVE;
+		picture.SetRect( 72, 130, 880, 440 );
+
+		BackRow();
+		AddRows( 600 );
+		AddItem( picture );
+	}
+	CMenuBitmap picture;
+};
+ADD_MENU( menu_xbox_layout, CMenuXbLayout, UI_XboxLayout_Menu );
+
+/*
+=================
+Controller
+=================
+*/
+class CMenuXbController : public CMenuXbScreen
+{
+public:
+	CMenuXbController() : CMenuXbScreen( "CMenuXbController" ) { }
+private:
+	void _Init() override
+	{
+		static const char *aimNames[] = { "Off", "Low", "Medium", "High" };
+
+		title = L( "Controller" );
+
+		NewRow()->SetupButton( L( "Controller layout" ), L( "See what every button does" ), UI_XboxLayout_Menu );
+		NewRow()->SetupSlider( L( "Look sensitivity" ), L( "How fast the right stick turns the view" ), "joy_look_sens", 0.25f, 3.0f, 0.05f, false );
+		NewRow()->SetupList( L( "Aim assist" ), L( "Slows and nudges your aim when it crosses an enemy" ), "joy_aimassist", aimNames, NULL, 4 );
+		NewRow()->SetupToggle( L( "Invert look" ), L( "Push the right stick up to look down" ), "joy_invert" );
+		NewRow()->SetupToggle( L( "Toggle crouch" ), L( "Press B once to crouch and again to stand, instead of holding it" ), "joy_crouch_toggle" );
+		NewRow()->SetupToggle( L( "Quick turn" ), L( "Turning speeds up when the right stick is held fully sideways" ), "joy_quickturn" );
+		NewRow()->SetupToggle( L( "Auto-aim" ), L( "Half-Life's own auto-aim: shots bend slightly toward enemies" ), "sv_aim" );
+		NewRow()->SetupToggle( L( "Vibration" ), L( "Rumble when firing, taking damage and from explosions" ), "vibration_enable" );
+		BackRow();
+		AddRows();
+	}
+};
+ADD_MENU( menu_xbox_controller, CMenuXbController, UI_XboxController_Menu );
+
+/*
+=================
+Gameplay
+=================
+*/
+class CMenuXbGameplay : public CMenuXbScreen
+{
+public:
+	CMenuXbGameplay() : CMenuXbScreen( "CMenuXbGameplay" ) { }
+private:
+	void _Init() override
+	{
+		static const char *bloodNames[] = { "Disabled", "Default", "Green", "Extreme" };
+
+		title = L( "Gameplay" );
+
+		NewRow()->SetupList( L( "Blood" ),
+			L( "Default: droplets and pools. Green: alien-coloured. Extreme: spurts, wall runs, drips, blood on screen" ),
+			"xb_blood", bloodNames, NULL, 4 );
+		NewRow()->SetupToggle( L( "Ragdolls" ), L( "Bodies fall and tumble with physics instead of playing a death animation" ), "xb_ragdoll" );
+		BackRow();
+		AddRows();
+	}
+};
+ADD_MENU( menu_xbox_gameplay, CMenuXbGameplay, UI_XboxGameplay_Menu );
+
+/*
+=================
+Audio
+=================
+*/
+class CMenuXbAudio : public CMenuXbScreen
+{
+public:
+	CMenuXbAudio() : CMenuXbScreen( "CMenuXbAudio" ) { }
+private:
+	void _Init() override
+	{
+		title = L( "Audio" );
+
+		NewRow()->SetupSlider( L( "Game volume" ), L( "Weapons, voices and everything else in the world" ), "volume", 0.0f, 1.0f, 0.05f, true );
+		NewRow()->SetupSlider( L( "Music volume" ), L( "The soundtrack" ), "MP3Volume", 0.0f, 1.0f, 0.05f, true );
+		NewRow()->SetupSlider( L( "HEV suit volume" ), L( "The suit's voice: health, ammo and hazard warnings" ), "suitvolume", 0.0f, 1.0f, 0.05f, true );
+		NewRow()->SetupToggle( L( "Room echo" ), L( "Echo and reverb that change with the size of the room" ), "room_off", true );
+		BackRow();
+		AddRows();
+	}
+};
+ADD_MENU( menu_xbox_audio, CMenuXbAudio, UI_XboxAudio_Menu );
+
+/*
+=================
+Video
+=================
+*/
+class CMenuXbVideo : public CMenuXbScreen
+{
+public:
+	CMenuXbVideo() : CMenuXbScreen( "CMenuXbVideo" ) { }
+private:
+	void _Init() override
+	{
+		title = L( "Video" );
+
+		// same ranges as the stock menu: gamma 1.8-3.0, brightness 0-3
+		NewRow()->SetupSlider( L( "Gamma" ), L( "Overall light level of the picture" ), "gamma", 1.8f, 3.0f, 0.06f, true );
+		NewRow()->SetupSlider( L( "Brightness" ), L( "Lifts the dark areas" ), "brightness", 0.0f, 3.0f, 0.15f, true );
+		NewRow()->SetupToggle( L( "Detail textures" ), L( "Extra surface detail up close, where the map has it" ), "r_detailtextures" );
+		NewRow()->SetupToggle( L( "Overbrights" ), L( "Brighter, punchier lighting like the original software look" ), "gl_overbright" );
+		NewRow()->SetupToggle( L( "Texture filtering" ), L( "Smooth textures. Off gives the sharp pixelated look" ), "gl_texture_nearest", true );
+		BackRow();
+		AddRows();
+	}
+};
+ADD_MENU( menu_xbox_video, CMenuXbVideo, UI_XboxVideo_Menu );
+
+/*
+=================
+Settings
+=================
+*/
+class CMenuXbSettings : public CMenuXbScreen
+{
+public:
+	CMenuXbSettings() : CMenuXbScreen( "CMenuXbSettings" ) { }
+private:
+	void _Init() override
+	{
+		title = L( "Settings" );
+
+		NewRow()->SetupButton( L( "Controller" ), L( "Button layout, look sensitivity, aim assist and vibration" ), UI_XboxController_Menu );
+		NewRow()->SetupButton( L( "Gameplay" ), L( "Blood and ragdolls" ), UI_XboxGameplay_Menu );
+		NewRow()->SetupButton( L( "Audio" ), L( "Game, music and HEV suit volume" ), UI_XboxAudio_Menu );
+		NewRow()->SetupButton( L( "Video" ), L( "Gamma, brightness and texture quality" ), UI_XboxVideo_Menu );
+		BackRow();
+		AddRows();
+	}
+};
+ADD_MENU( menu_xbox_settings, CMenuXbSettings, UI_XboxSettings_Menu );
+
+#endif // XASH_UWP
